# Gemini AI API key (required for job analysis feature)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string (set automatically by Vercel Postgres)
# Leave blank for local development — SQLite is used instead
POSTGRES_URL=

# Secret to protect the cron scrape endpoint on Vercel (optional but recommended)
CRON_SECRET=your_random_secret_here

# Optional: Handshake credentials for full access
HANDSHAKE_EMAIL=your_email@university.edu
HANDSHAKE_PASSWORD=your_password
